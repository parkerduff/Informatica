# Copy to .env (git-ignored) and fill in. Replaces $HOME/.use / $HOME/.pw.

# --- Oracle source (EHRP / NKNIGHT) ---
ORA_BIISPRD_SRC_HOST=biisprd-src.hhs.gov
ORA_BIISPRD_SRC_PORT=1521
ORA_BIISPRD_SRC_SERVICE=BIISPRD
ORA_BIISPRD_SRC_USER=
ORA_BIISPRD_SRC_PASSWORD=

# --- Oracle target (BIIS / HISTDBA / INFO_TARGET_DEV) ---
ORA_BIIS_HOST=biis.hhs.gov
ORA_BIIS_PORT=1521
ORA_BIIS_SERVICE=BIIS
ORA_BIIS_USER=
ORA_BIIS_PASSWORD=

# --- Oracle schemas (owners) ---
SCHEMA_EHRP=EHRP
SCHEMA_NKNIGHT=NKNIGHT
SCHEMA_HISTDBA=HISTDBA
SCHEMA_INFO_TARGET=INFO_TARGET_DEV

# --- SFTP dropbox (sa-cdirect@m1csv301.hhs.gov) ---
SFTP_HOST=m1csv301.hhs.gov
SFTP_USER=sa-cdirect
SFTP_PORT=22
SFTP_KEY_PATH=
SFTP_PASSWORD=

# --- SMTP (replaces mailx) ---
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SENDER=biisint@hhs.gov
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# --- Filesystem paths (from bin/SETENV) ---
BIIS_INPUT_DIR=/data/BIISINT/data/int/in/
BIIS_CPM_OUT_DIR=/data/BIISINT/data/int/out/CPM/
BIIS_LES_OUT_DIR=/data/BIISINT/data/int/out/LES/
BIIS_LOG_DIR=/home/sa-biisint/data/int/log

# --- Spark ---
ORACLE_JDBC_JAR=/opt/oracle/ojdbc8.jar

# --- Notification recipients (space or comma separated; optional overrides) ---
# EHRP2BIIS_RECIPIENTS=
# TRANSFER_RECIPIENTS=
