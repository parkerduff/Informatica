# BIIS ETL Production Environment Configuration
BIIS_ENVIRONMENT=prod

# Oracle JDBC connections
ORA_BIISPRD_SRC_URL=jdbc:oracle:thin:@//biisprd-src:1521/BIISPRD
ORA_BIISPRD_SRC_USER=prod_user
ORA_BIISPRD_SRC_PASSWORD=changeme
ORA_BIIS_URL=jdbc:oracle:thin:@//biis-prod:1521/BIISPRD
ORA_BIIS_USER=prod_user
ORA_BIIS_PASSWORD=changeme

# Oracle DSN for cx_Oracle
ORA_BIISPRD_SRC_DSN=biisprd-src:1521/BIISPRD
ORA_BIIS_DSN=biis-prod:1521/BIISPRD

# File paths
BIIS_DATA_ROOT=/data/BIISINT
BIIS_HOME=/home/sa-biisint

# SFTP
SFTP_HOST=m1csv301.hhs.gov
SFTP_USER=sa-cdirect
SFTP_PORT=22

# Email
SMTP_HOST=smtp.hhs.gov
SMTP_PORT=25
EMAIL_FROM=biis-etl@hhs.gov
EMAIL_RECIPIENTS=peter.chen@hhs.gov nathan.knight@hhs.gov marvin.simon@hhs.gov
TRANSFER_EMAIL_RECIPIENTS=mariappan.muthiah@hhs.gov nathan.knight@hhs.gov karen.williams@hhs.gov marvin.simon@hhs.gov Robin.Cunningham@hhs.gov minh.tran@hhs.gov

# Spark
ORACLE_JDBC_JAR=/opt/spark/jars/ojdbc8.jar
SPARK_DRIVER_MEMORY=8g
SPARK_EXECUTOR_MEMORY=8g
SPARK_EXECUTOR_CORES=4
