# BIIS ETL Test Environment Configuration
BIIS_ENVIRONMENT=test

# Oracle JDBC connections
ORA_BIISPRD_SRC_URL=jdbc:oracle:thin:@//test-biisprd-src:1521/BIISTST
ORA_BIISPRD_SRC_USER=test_user
ORA_BIISPRD_SRC_PASSWORD=changeme
ORA_BIIS_URL=jdbc:oracle:thin:@//test-biis:1521/BIISTST
ORA_BIIS_USER=test_user
ORA_BIIS_PASSWORD=changeme

# Oracle DSN for cx_Oracle
ORA_BIISPRD_SRC_DSN=test-biisprd-src:1521/BIISTST
ORA_BIIS_DSN=test-biis:1521/BIISTST

# File paths
BIIS_DATA_ROOT=/data/BIISINT
BIIS_HOME=/home/sa-biisint

# SFTP
SFTP_HOST=m1csv301-test.hhs.gov
SFTP_USER=sa-cdirect
SFTP_PORT=22

# Email
SMTP_HOST=smtp-test.hhs.gov
SMTP_PORT=25
EMAIL_FROM=biis-etl-test@hhs.gov
EMAIL_RECIPIENTS=test-team@hhs.gov

# Spark
ORACLE_JDBC_JAR=/opt/spark/jars/ojdbc8.jar
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=2
