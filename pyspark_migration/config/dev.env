# BIIS ETL Development Environment Configuration
BIIS_ENVIRONMENT=dev

# Oracle JDBC connections
ORA_BIISPRD_SRC_URL=jdbc:oracle:thin:@//dev-biisprd-src:1521/BIISDEV
ORA_BIISPRD_SRC_USER=dev_user
ORA_BIISPRD_SRC_PASSWORD=changeme
ORA_BIIS_URL=jdbc:oracle:thin:@//dev-biis:1521/BIISDEV
ORA_BIIS_USER=dev_user
ORA_BIIS_PASSWORD=changeme

# Oracle DSN for cx_Oracle
ORA_BIISPRD_SRC_DSN=dev-biisprd-src:1521/BIISDEV
ORA_BIIS_DSN=dev-biis:1521/BIISDEV

# File paths
BIIS_DATA_ROOT=/data/BIISINT
BIIS_HOME=/home/sa-biisint

# SFTP
SFTP_HOST=m1csv301-dev.hhs.gov
SFTP_USER=sa-cdirect
SFTP_PORT=22

# Email
SMTP_HOST=localhost
SMTP_PORT=25
EMAIL_FROM=biis-etl-dev@hhs.gov
EMAIL_RECIPIENTS=dev-team@hhs.gov

# Spark
ORACLE_JDBC_JAR=/opt/spark/jars/ojdbc8.jar
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=1
